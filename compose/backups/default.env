# Daily Backup Schedule (1:00 AM each day)
DAILY_BACKUP_CRON_EXPRESSION="0 1 * * *"
DAILY_BACKUP_RETENTION_DAYS=7
DAILY_BACKUP_FILENAME_PREFIX=daily-backup

# Weekly Backup Schedule (1:00 AM each Sunday + 3 weekly backups)
WEEKLY_BACKUP_CRON_EXPRESSION="0 1 * * SUN"
WEEKLY_BACKUP_RETENTION_DAYS=21
WEEKLY_BACKUP_FILENAME_PREFIX=weekly-backup

# To add Slack Notifications - https://containrrr.dev/shoutrrr/v0.5/guides/slack/
NOTIFICATION_LEVEL=error

# Configurable env file for portainer (portainer saves .env file in the root of a cloned repo)
STACK_ENV_FILE_RELATIVE_PATH=../../stack.env

FRONTEGG_ENVIRONMENT=production
