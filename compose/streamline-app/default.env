### common envs
FRONTEGG_ENVIRONMENT=development

### cloudflared envs
CLOUDFLARED_TOKEN=null
CLOUDFLARE_TUNNEL_REPLICAS=0
CLOUDFLARED_VERSION=latest

### engine envs
## In production repo dev repository will always be changed to prod repo by release pipeline
ENGINE_IMAGE=gmdhstreamline/streamline-engine-server-dev
ENGINE_TAG=v2026-9-3-7
LOG_LEVEL=info

### web envs
## In production repo dev repository will always be changed to prod repo by release pipeline
WEB_IMAGE=gmdhstreamline/streamline-web-dev
WEB_TAG=v2026-9-3-7

## proxied URLs
STREAMLINE_WEB_URL_PATH=/
CONTROLLER_FRONTEND_URL_PATH=/admin/ui


### mcp envs
## In production repo dev repository will always be changed to prod repo by release pipeline
MCP_IMAGE=gmdhstreamline/mcp-dev
MCP_TAG=v2026-9-2-2
## MCP is off until the customer turns it on in the controller. It sets all three.
## ENGINE_MCP_ARG must stay empty while MCP is off - older engines do not know the flag.
MCP_REPLICAS=0
MCP_PUBLIC_URL=
ENGINE_MCP_ARG=
## The path MCP is served on. Changing it also changes the /.well-known routes in compose.yml.
MCP_URL_PATH=/mcp
MCP_LOG_LEVEL=INFO
