### common envs
FRONTEGG_ENVIRONMENT=development

### cloudflared envs
CLOUDFLARED_TOKEN=null
CLOUDFLARE_TUNNEL_REPLICAS=0
CLOUDFLARED_VERSION=latest

### engine envs
## In production repo dev repository will always be changed to prod repo by release pipeline
ENGINE_IMAGE=gmdhstreamline/streamline-engine-server-dev
ENGINE_TAG=v2026-8-2-8
LOG_LEVEL=info

### web envs
## In production repo dev repository will always be changed to prod repo by release pipeline
WEB_IMAGE=gmdhstreamline/streamline-web-dev
WEB_TAG=v2026-8-2-8

## proxied URLs
STREAMLINE_WEB_URL_PATH=/
CONTROLLER_FRONTEND_URL_PATH=/admin/ui


### mcp envs
## In production repo dev repository will always be changed to prod repo by release pipeline
MCP_IMAGE=gmdhstreamline/mcp-dev
MCP_TAG=v2026-9-1-0
## MCP is off until the customer enables it in the controller, which sets MCP_REPLICAS=1
## and MCP_PUBLIC_URL together. The engine reads an empty MCP_PUBLIC_URL as "no MCP server
## to reach", so the two stay consistent by construction.
MCP_REPLICAS=0
MCP_PUBLIC_URL=
## The URL prefix MCP owns, under the host the customer already reaches Streamline on.
## Changing it also changes the two /.well-known paths the routers in compose.yml carry.
MCP_URL_PATH=/mcp
MCP_LOG_LEVEL=INFO
## The base URL customers open Streamline on, as they typed it in the controller. Only the
## controller reads it back; MCP_PUBLIC_URL above is this plus MCP_URL_PATH.
STREAMLINE_PUBLIC_HOST=
