### common envs
FRONTEGG_ENVIRONMENT=production

### cloudflared envs
CLOUDFLARED_TOKEN=null
CLOUDFLARE_TUNNEL_REPLICAS=0
CLOUDFLARED_VERSION=latest

### engine envs
## In production repo dev repository will always be changed to prod repo by release pipeline
ENGINE_IMAGE=gmdhstreamline/streamline-engine-server
ENGINE_TAG=v2026-5-1-1
LOG_LEVEL=info

### web envs
## In production repo dev repository will always be changed to prod repo by release pipeline
WEB_IMAGE=gmdhstreamline/streamline-web
WEB_TAG=v2026-5-1-1

## proxied URLs
STREAMLINE_WEB_URL_PATH=/
CONTROLLER_FRONTEND_URL_PATH=/admin/ui

